# Copiar a backend/.env (nunca commitear el real).
# Los valores de abajo son PLACEHOLDERS: cada developer elige los suyos y los
# genera una sola vez. La password de la BD va con el rol que creo cada uno.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=despegar
DB_USER=despegar
DB_PASS=cambiar_por_tu_password_local
JWT_SECRET=cambiar_por_secreto_aleatorio_de_32_bytes_minimo
BCRYPT_COST=10
JWT_TTL_HOURS=8

# Refresh token: vida del token opaco de larga duracion (1 a 90 dias).
REFRESH_TTL_DAYS=30

# Entorno: development | production. Solo afecta el aviso de CORS abierto.
APP_ENV=development

# CORS: vacio = sin cabeceras CORS (solo apps nativas) | "*" = cualquier origen
# (solo dev) | "https://a.com,https://b.com" = allowlist.
CORS_ORIGIN=*

# Cuotas de peticiones (por IP y/o por cuenta). 0 = usar el valor por defecto.
#   LOGIN_RATE_LIMIT: intentos de login por IP en LOGIN_RATE_WINDOW segundos.
#   LOGIN_RATE_ACCOUNT_LIMIT: intentos de login por cuenta en la misma ventana.
#   REGISTER_RATE_LIMIT: altas por IP en REGISTER_RATE_WINDOW segundos.
#   REFRESH_RATE_LIMIT: renovaciones de sesion por IP en LOGIN_RATE_WINDOW segundos.
# En desarrollo local podés subirlos (las suites de tests registran usuarios).
LOGIN_RATE_LIMIT=30
LOGIN_RATE_ACCOUNT_LIMIT=20
LOGIN_RATE_WINDOW=60
REGISTER_RATE_LIMIT=30
REGISTER_RATE_WINDOW=3600
REFRESH_RATE_LIMIT=60
