# Secretos: NUNCA al repo.
#   .env              -> backend/.env (DB_*, JWT_SECRET), apps/*/.env (URL API local)
#   .env.*            -> cualquier variante (.env.local, .env.railway, ...)
#  !.env.example      -> la plantilla si se versiona (sin valores reales)
.env
.env.*
!.env.example

# Node / Expo
node_modules/
.expo/
dist/
build/
android/          # generado por "expo prebuild" (build local)
ios/              # generado por "expo prebuild" (build local)
*.log
.vscode/

# Datos y artefactos locales
backend/uploads/
backend/.env.tmp
backend/var/
apps/*/.env.tmp
