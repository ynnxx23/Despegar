        <mxCell id="tests" value="Tests F2/F3/F7/F8/F9/F10/F11/F12/F13 + e2e Maestro + CI" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=11;" vertex="1" parent="1">
