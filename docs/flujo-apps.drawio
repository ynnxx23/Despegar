        <mxCell id="h-shared" value="SHARED (apps/shared) + SecureStore" style="rounded=1;html=1;fontStyle=1;fontSize=12;fillColor=#F3F4F6;strokeColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="300" y="65" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h-back" value="BACKEND PHP 8.2 POO + PDO (backend/public/index.php)" style="rounded=1;html=1;fontStyle=1;fontSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="560" y="65" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h-pg" value="PostgreSQL (schema + seeds + migrate_02-07)" style="rounded=1;html=1;fontStyle=1;fontSize=12;fillColor=#D1FAE5;strokeColor=#047857;" vertex="1" parent="1">
          <mxGeometry x="860" y="65" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h-ag" value="APP 2 · Centro Resolución (rol agente, Expo RN)" style="rounded=1;html=1;fontStyle=1;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="1150" y="65" width="270" height="30" as="geometry" />
        </mxCell>
        <!-- ===== Actores ===== -->
        <mxCell id="actor-v" value="Viajero" style="ellipse;html=1;fillColor=#EBE5F5;strokeColor=#4300D2;fontColor=#270570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="105" width="100" height="50" as="geometry" />
