  <diagram name="Flujo-2-Apps-Despegar" id="despegar-flujo-2apps">
    <mxGraphModel dx="1420" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="960" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- ===== Titulo ===== -->
        <mxCell id="title" value="Despegar Grupo 8 — Flujo detallado 2 Apps + API PHP + PostgreSQL" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1E1B2E;align=center;" vertex="1" parent="1">
          <mxGeometry x="240" y="10" width="960" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="JWT + refresh rotado 30d. Viajero y Agente comparten API y BD. Loop: viajero reporta+responde - agente gestiona+IA - viajero lee. Contrato OpenAPI v1.4.1.   Archivo: docs/flujo-apps.drawio (abrir en app.diagrams.net)" style="text;html=1;fontSize=11;fontColor=#6B7280;align=center;" vertex="1" parent="1">
          <mxGeometry x="240" y="38" width="960" height="20" as="geometry" />
        </mxCell>
        <!-- ===== Cabeceras carriles ===== -->
        <mxCell id="h-viaj" value="APP 1 · Portal Viajero (rol viajero, Expo RN)" style="rounded=1;html=1;fontStyle=1;fontSize=12;fillColor=#EBE5F5;strokeColor=#4300D2;fontColor=#270570;" vertex="1" parent="1">
          <mxGeometry x="20" y="65" width="260" height="30" as="geometry" />
